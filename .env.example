# Copy to .env and fill in. Never commit .env.
# Claude API key (optional: without it the app uses a keyword fallback)
ANTHROPIC_API_KEY=
# People Data Labs API key (optional: without it PDL search is skipped)
PDL_API_KEY=
# Exa API key (optional: without it Exa web search is skipped)
EXA_API_KEY=
# Claude model to use
CLAUDE_MODEL=claude-sonnet-5-5
# How many PDL records to request per search (1 credit each; free plan = 100/month)
PDL_SIZE=5
# Demo without a PDL key: serve fictional PDL-shaped records, clearly labelled (ignored if PDL_API_KEY is set)
PDL_DEMO=false
# How many Exa results to request per search
EXA_SIZE=5
# Port for the web server
PORT=3000
